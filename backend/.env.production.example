# =============================================================================
# AI Case Manager — Production Environment Template (.env.production)
# =============================================================================
# IMPORTANT: Never commit production credentials, real API keys, or live passwords.

# Core Service Configuration
PROJECT_NAME="AI Municipal Corporation Case Manager"
ENVIRONMENT=production
API_V1_STR=/api/v1
ENABLE_DOCS=false

# Managed PostgreSQL Database (Render PostgreSQL / Supabase / AWS RDS)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.yourproject:YourStrongDatabasePassword123@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Security & JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=generate_and_insert_a_64_character_random_hex_or_urlsafe_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
SECURE_COOKIES=true

# Strict CORS Settings (List production domain URLs explicitly)
CORS_ORIGINS=["https://grievance.city.gov","https://admin.grievance.city.gov","https://ai-case-manager.onrender.com"]

# Production AI Integration Layer (OpenAI / Anthropic / Gemini API)
AI_PROVIDER=external
AI_API_KEY=sk-prod-your-ai-api-key-here
AI_API_BASE_URL=https://api.openai.com/v1

# Storage (Supabase Storage / AWS S3 / Cloudflare R2)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25
STORAGE_BUCKET_NAME=case-evidence-production
STORAGE_ENDPOINT_URL=https://your-project.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=your_production_storage_access_key
STORAGE_SECRET_KEY=your_production_storage_secret_key

# Transactional Email Gateway (SendGrid / AWS SES / Resend)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_sendgrid_production_api_key
SMTP_TLS=true
EMAILS_FROM_EMAIL=no-reply@grievance.city.gov
EMAILS_FROM_NAME="City Municipal Grievance Redressal"
