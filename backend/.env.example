# =============================================================================
# AI Case Manager — Development Environment Variables (.env)
# =============================================================================

# Project & Runtime
PROJECT_NAME="AI Municipal Case Manager"
ENVIRONMENT=development
API_V1_STR=/api/v1
ENABLE_DOCS=true

# Database (SQLite default for quick local testing; or PostgreSQL)
DATABASE_URL=sqlite:///./ai_case_manager.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_case_manager

# Security & Authentication
JWT_SECRET_KEY=development_jwt_secret_key_minimum_32_characters_long_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURE_COOKIES=false

# CORS (Allow local dev ports, mobile emulator, and web)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","*"]

# AI Integration Layer (Advisory Triage & Insights)
AI_PROVIDER=external
AI_API_KEY=
AI_API_BASE_URL=

# Evidence & Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15
STORAGE_BUCKET_NAME=case-evidence
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Notification & Transactional Email (Optional for local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=notifications@city.gov
EMAILS_FROM_NAME="AI Municipal Corporation"
