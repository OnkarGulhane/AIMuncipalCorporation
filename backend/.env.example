# Project Settings
PROJECT_NAME="AI Case Manager"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_case_manager

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_min_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]

# External AI Service
AI_PROVIDER=external
AI_API_KEY=
AI_API_BASE_URL=

# Object Storage (Supabase Storage / S3)
STORAGE_BUCKET_NAME=case-evidence
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
